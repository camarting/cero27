---
import { siteConfig } from '../config/site';
---
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><img src="/assets/CERO27-logo-horizontal.svg" alt="CERO27" /><p>{siteConfig.slogan}</p></div><div><h2>Soluciones</h2><ul>{siteConfig.solutions.map((solution)=><li><a href={solution.href}>{solution.label}</a></li>)}</ul></div><div><h2>Navegación</h2><ul>{siteConfig.navigation.map((item)=><li><a href={item.href}>{item.label}</a></li>)}<li><a href={siteConfig.privacyPolicyUrl} target="_blank" rel="noopener">Política de tratamiento de datos</a></li></ul><p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><br />{siteConfig.location}</p></div></div><div class="container footer-bottom"><span>CERO27</span><span>{siteConfig.location} · <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> · <a href={siteConfig.privacyPolicyUrl} target="_blank" rel="noopener">Política de tratamiento de datos</a></span></div></footer>
<a class="whatsapp-float" href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp (se abre en una nueva pestaña)"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5z"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M8.5 9.5h7M8.5 12.5h4"/></svg><span>WhatsApp</span></a>
