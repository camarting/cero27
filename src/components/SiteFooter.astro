---
import { siteConfig } from '../config/site';
---
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><img src="/assets/CERO27-logo-horizontal.svg" alt="CERO27" /><p>{siteConfig.slogan}</p></div><div><h2>Soluciones</h2><ul>{siteConfig.solutions.map((solution)=><li><a href={solution.href}>{solution.label}</a></li>)}</ul></div><div><h2>Navegación</h2><ul>{siteConfig.navigation.map((item)=><li><a href={item.href}>{item.label}</a></li>)}<li><a href="/politica-de-privacidad/">Política de privacidad</a></li></ul><p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><br />{siteConfig.location}</p></div></div><div class="container footer-bottom"><span>CERO27</span><span>{siteConfig.location} · <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> · <a href="/politica-de-privacidad/">Política de privacidad</a></span></div></footer>
