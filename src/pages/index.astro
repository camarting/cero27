---
import { siteConfig } from '../config/site';
import '../styles/global.css';
const approach = [
  { step: 'Evaluamos', text: 'Revisamos cómo está hoy tu empresa: su información, sus procesos y sus riesgos.' },
  { step: 'Orientamos', text: 'Te explicamos en lenguaje claro qué encontramos y qué significa para tu negocio.' },
  { step: 'Priorizamos', text: 'Definimos qué atender primero según el impacto y los recursos disponibles.' },
  { step: 'Acompañamos', text: 'Te apoyamos mientras avanzas con las mejoras que decidiste implementar.' },
];
const solutionDetails = [
  { subtitle: 'Conoce tus riesgos. Protege lo que importa.', text: 'Ayudamos a tu empresa a comprender sus riesgos, reconocer brechas y establecer prioridades para fortalecer la seguridad de la información según sus necesidades. ISO/IEC 27001 es un marco de referencia.' },
  { subtitle: 'Usa la inteligencia artificial con criterio, control y responsabilidad.', text: 'Ayudamos a comprender los riesgos y la gobernanza asociados al uso de inteligencia artificial, incluyendo información, responsabilidades y controles. ISO/IEC 42001 es un marco de referencia.' },
  { subtitle: 'Más control sobre la impresión. Más visibilidad sobre tus recursos.', text: 'Evaluación y orientación sobre procesos de impresión, visibilidad, control, seguridad, eficiencia y costos.' },
  { subtitle: 'El conocimiento también es parte de la seguridad.', text: 'Contenido detallado en preparación.' },
];
const solutionIcons = ['shield', 'ai', 'print', 'training'];
---
<!doctype html><html lang="es"><head>
<script is:inline>document.documentElement.classList.add('js')</script>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="CERO27 ayuda a las PYMES a comprender sus riesgos, establecer prioridades y avanzar en seguridad de la información e inteligencia artificial desde una perspectiva clara y práctica." />
<link rel="canonical" href={`${siteConfig.siteUrl}/`} /><meta property="og:title" content={`${siteConfig.name} — ${siteConfig.slogan}`} /><meta property="og:description" content="Seguridad, IA y gobernanza, Print Management y capacitación para PYMES." /><meta property="og:type" content="website" /><meta property="og:url" content={`${siteConfig.siteUrl}/`} /><title>{siteConfig.name} — {siteConfig.slogan}</title>
</head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header"><div class="container header-inner">
<a class="brand" href="/" aria-label="CERO27 — Inicio"><img src="/assets/CERO27-Logo-Original.png" alt="CERO27 — Seguridad que te permite avanzar" /></a>
<nav class="primary-nav" aria-label="Navegación principal">{siteConfig.navigation.map((item)=><a href={item.href} class={item.label==='Inicio'?'active':''}>{item.label}</a>)}</nav>
<a class="button button-primary header-cta" href={siteConfig.diagnosticUrl} target="_blank" rel="noopener noreferrer">Conocer mi nivel de riesgo <span>→</span></a>
<button class="mobile-menu" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-navigation">Menú</button></div>
<nav id="primary-navigation" class="mobile-nav" aria-label="Navegación móvil" hidden>{siteConfig.navigation.map((item)=><a href={item.href}>{item.label}</a>)}<a class="mobile-diagnostic" href={siteConfig.diagnosticUrl} target="_blank" rel="noopener noreferrer">Conocer mi nivel de riesgo →</a></nav></header>
<main id="contenido">
<section class="hero" aria-labelledby="hero-title"><div class="hero-photo" aria-hidden="true"></div><div class="hero-overlay" aria-hidden="true"></div><div class="container hero-inner"><div class="hero-copy-block"><p class="eyebrow">CERO27</p><h1 id="hero-title">Seguridad<br />que te permite<br /><span>avanzar</span></h1><p class="hero-copy">Ayudamos a las PYMES a entender sus riesgos, priorizar lo importante y mejorar su seguridad sin complicar su negocio.</p><div class="hero-actions"><a class="button button-primary button-large" href={siteConfig.diagnosticUrl} target="_blank" rel="noopener noreferrer">Conocer mi nivel de riesgo <span>→</span></a><a class="button-link" href="/conversemos/">Conversemos <span>→</span></a></div></div></div>
<div class="container solution-strip" aria-label="Soluciones principales">{siteConfig.solutions.map((solution,index)=><a class="solution-item" href={solution.href}><span class={`solution-icon ${solutionIcons[index]}`} aria-hidden="true"></span><span>{solution.label}</span><i></i></a>)}</div></section>
<section class="section solutions-section" id="soluciones" aria-labelledby="solutions-title"><div class="container"><p class="section-kicker reveal">Soluciones</p><h2 id="solutions-title" class="reveal">Claridad para decidir.<br /><span>Seguridad para avanzar.</span></h2>
<div class="solution-tabs reveal"><div class="solution-tablist" role="tablist" aria-label="Soluciones">{siteConfig.solutions.map((solution,index)=><button type="button" role="tab" id={`tab-${index}`} aria-controls={`panel-${index}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1}><span class="solution-index">0{index+1}</span>{solution.label}</button>)}</div>
{siteConfig.solutions.map((solution,index)=><div class="solution-panel" role="tabpanel" id={`panel-${index}`} aria-labelledby={`tab-${index}`} hidden={index!==0}><span class="solution-icon-lg"><span class={`solution-icon ${solutionIcons[index]}`} aria-hidden="true"></span></span><div><h3>{solutionDetails[index].subtitle}</h3><p>{solutionDetails[index].text}</p><a class="button button-primary" href={solution.href}>Conocer solución <span>→</span></a></div></div>)}</div></div></section>
<section class="section approach" id="nosotros" aria-labelledby="approach-title"><div class="container"><p class="section-kicker reveal">Nuestro enfoque</p><h2 id="approach-title" class="reveal">Evaluamos. Orientamos.<br /><span>Priorizamos. Acompañamos.</span></h2><ol class="approach-grid">{approach.map((item,index)=><li class="approach-step reveal" style={`--d:${index*120}ms`}><span>0{index+1}</span><h3>{item.step}</h3><p>{item.text}</p></li>)}</ol></div></section>
<section class="section resources" id="recursos" aria-labelledby="resources-title"><div class="container resources-inner reveal"><div><p class="section-kicker">Recursos</p><h2 id="resources-title">Decisiones mejor informadas.</h2></div><p>Contenido práctico para comprender riesgos, ordenar prioridades y avanzar con mayor criterio.</p></div></section>
<section class="section final-cta" id="conversemos" aria-labelledby="final-title"><div class="container final-cta-inner reveal"><div><p class="section-kicker">Siguiente paso</p><h2 id="final-title">Conocer mi nivel de riesgo</h2><p>Una primera mirada para saber dónde estás y qué conviene priorizar.</p></div><a class="button button-primary button-large" href={siteConfig.diagnosticUrl} target="_blank" rel="noopener noreferrer">Conocer mi nivel de riesgo <span>→</span></a></div></section>
</main>
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><img src="/assets/CERO27-Logo-Original.png" alt="CERO27" /><p>{siteConfig.slogan}</p></div><div><h2>Soluciones</h2><ul>{siteConfig.solutions.map((solution)=><li><a href={solution.href}>{solution.label}</a></li>)}</ul></div><div><h2>Navegación</h2><ul>{siteConfig.navigation.map((item)=><li><a href={item.href}>{item.label}</a></li>)}</ul></div></div><div class="container footer-bottom"><span>CERO27</span><span>{siteConfig.location} · <a href="mailto:info@cero27.co">{siteConfig.email}</a> · <a href="/politica-de-privacidad/">Política de privacidad</a></span></div></footer>
<script>const menuButton=document.querySelector('.mobile-menu');const mobileNavigation=document.querySelector('#primary-navigation');menuButton?.addEventListener('click',()=>{if(!mobileNavigation)return;const open=menuButton.getAttribute('aria-expanded')==='true';menuButton.setAttribute('aria-expanded',String(!open));menuButton.setAttribute('aria-label',open?'Abrir menú':'Cerrar menú');mobileNavigation.hidden=open;});
const tabs=[...document.querySelectorAll('.solution-tablist [role=tab]')];
const select=(t)=>{tabs.forEach((x)=>{const on=x===t;x.setAttribute('aria-selected',String(on));x.tabIndex=on?0:-1;const panel=document.getElementById(x.getAttribute('aria-controls')||'');if(panel)panel.hidden=!on;});};
tabs.forEach((t,i)=>{t.addEventListener('click',()=>select(t));t.addEventListener('keydown',(e)=>{const k=e.key;let n=-1;if(k==='ArrowRight'||k==='ArrowDown')n=(i+1)%tabs.length;if(k==='ArrowLeft'||k==='ArrowUp')n=(i-1+tabs.length)%tabs.length;if(k==='Home')n=0;if(k==='End')n=tabs.length-1;if(n>=0){e.preventDefault();tabs[n].focus();select(tabs[n]);}});});
const items=document.querySelectorAll('.reveal');
if('IntersectionObserver' in window){const io=new IntersectionObserver((entries)=>{entries.forEach((en)=>{if(en.isIntersecting){en.target.classList.add('is-visible');io.unobserve(en.target);}});},{threshold:.15,rootMargin:'0px 0px -40px 0px'});items.forEach((el)=>io.observe(el));}else{items.forEach((el)=>el.classList.add('is-visible'));}
</script>
</body></html>

